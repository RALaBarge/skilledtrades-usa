{
  "name": "skilledtrades-usa",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "skilledtrades-usa.com", "custom_domain": true },
    { "pattern": "www.skilledtrades-usa.com", "custom_domain": true },
    { "pattern": "skilledtradesmichigan.com", "custom_domain": true },
    { "pattern": "www.skilledtradesmichigan.com", "custom_domain": true }
  ]
}
